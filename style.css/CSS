body.scene-background {
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-image: url('assets/backgrounds/forest.jpg'); 
    background-size: cover;
    background-position: center;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #ffffff;
}

.game-container {
    background-color: rgba(0, 0, 0, 0.85);
    padding: 40px;
    border-radius: 12px;
    max-width: 600px;
    width: 90%;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
    border: 1px solid #444;
}

h1 {
    margin-top: 0;
    color: #f39c12;
    text-align: center;
    font-size: 1.8rem;
}

.narrative-box {
    margin: 25px 0;
    line-height: 1.6;
    font-size: 1.1rem;
    color: #ddd;
}

/* Organisation des boutons de choix */
.choices-container {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 30px;
}

/* Boutons personnalisés */
.btn {
    display: flex;
    align-items: center;
    gap: 15px;
    background-color: #2c3e50;
    color: white;
    padding: 12px 20px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
    transition: background-color 0.3s ease, transform 0.2s ease;
    border: 1px solid #34495e;
}

.btn:hover {
    background-color: #f39c12;
    color: #1a1a1a;
    transform: translateY(-2px);
}

.btn-icon {
    width: 24px;
    height: 24px;
    object-fit: contain;
}